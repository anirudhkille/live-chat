{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,mdx,js,jsx,json,md,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx,js,jsx,json,md,css,scss}\"",
    "analyze": "cross-env ANALYZE=true next build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npx oxlint --fix",
      "npx prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "npx prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-virtual": "^3.14.26",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.3",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.5",
    "react-hook-form": "^7.92.0",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=26.0.0"
